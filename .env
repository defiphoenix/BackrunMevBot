# BackrunMevBot — single-hop pump.fun (PumpSwap) -> Meteora backrun detector.
# Detection-only: no trading, no private keys. Values below are the same
# defaults src/config.ts falls back to when unset; uncomment/edit to override.

# --- Meteora pool filtering ---
MIN_POOL_TVL_USD=500

# --- Trigger / trade sizing ---
# Higher than the multi-strategy bot's default (10) — only backrun big sells.
BIG_SELL_THRESHOLD_SOL=8
TRADE_AMOUNT_SOL=0.25
MIN_PROFIT_SOL=0.0001

# --- Fees / slippage assumptions used in PnL math ---
PUMPSWAP_FEE_BPS=25
METEORA_FEE_BPS=200
SLIPPAGE_BPS=100
JITO_TIP_SOL=0.0001
PRIORITY_FEE_SOL=0.0001

# --- Jupiter quote API (single endpoint, no connection pool) ---
# Optional: set to switch from the lite tier (~1 req/s) to the pro tier (api.jup.ag).
JUPITER_API_KEY=
# JUPITER_QUOTE_API=https://lite-api.jup.ag/swap/v1
# JUPITER_MIN_REQUEST_GAP_MS=1100
JUPITER_QUOTE_MAX_AGE_MS=5000
# Note: JUPITER_BUY_DEXES / JUPITER_SELL_DEXES are fixed in code (Pump.fun Amm /
# Meteora DLMM,Meteora DAMM v2) and not env-overridable — this bot must only
# ever touch pump.fun and Meteora.

# --- Misc ---
TOKEN_DECIMALS=6
POOL_REFRESH_MS=600000
MAX_TRACKED_MINTS=10

# --- API / opportunity server ---
API_PORT=8788
OPPORTUNITY_HISTORY_SIZE=500
LOG_FILE=opportunities.log
